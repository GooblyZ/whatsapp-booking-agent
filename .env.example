# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Token you choose when registering the webhook in Meta Developer Console.
WHATSAPP_VERIFY_TOKEN=

# System user access token from Meta Business Manager.
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID from Meta Developer Console → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID from Meta Business Manager.
WHATSAPP_BUSINESS_ACCOUNT_ID=
