# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Safe to expose in the browser (anon key, enforces RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Meta / WhatsApp ─────────────────────────────────────────────────────────
# Found in: Meta for Developers → Your App → WhatsApp → API Setup

# A secret string you choose — must match what you enter in the Meta webhook config
META_VERIFY_TOKEN=your-chosen-verify-token

# Permanent access token (or system user token for production)
META_ACCESS_TOKEN=your-meta-access-token

# The phone number ID (not the phone number itself)
META_PHONE_NUMBER_ID=your-phone-number-id

# ─── App Config ──────────────────────────────────────────────────────────────
# The UUID of the business row in Supabase that this webhook handles.
# Required until per-business webhook routing is implemented.
DEFAULT_BUSINESS_ID=your-business-uuid-from-supabase
