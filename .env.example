# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Token you choose when registering the webhook in Meta Developer Console.
WHATSAPP_VERIFY_TOKEN=

# System user access token from Meta Business Manager.
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID from Meta Developer Console → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID from Meta Business Manager.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Gemini LLM Agent (optional) ───────────────────────────────────────────────
# Set LLM_AGENT_ENABLED=true and provide a valid GEMINI_API_KEY to enable LLM mode
# in the Agent Test Console. The rule-based analyzer remains active as fallback.
GEMINI_API_KEY=
LLM_AGENT_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
